# ============================================================
# .htaccess — para sa LIVE host (Hostinger/LiteSpeed).
#
# Sa XAMPP ay halos walang halaga ito; sa isang pampublikong host, ang
# buong folder ay nasa web root — kaya mababasa sa browser ang alinmang
# file maliban kung pipigilan.
#
# SINADYANG MAKITID. Ang unang bersyon nito ay may tatlong RedirectMatch
# na humaharang sa app/, inc/ at Database/ — at 500 ang isinagot ng host.
# Ang hugis na ito ay ang napatunayan nang gumagana ng FormFlow sa
# KAPAREHONG server, kaya huwag magdagdag ng direktiba rito nang hindi
# sinusubukan sa live site: ang pagkakamali rito ay hindi masamang
# pahina kundi PATAY na site.
#
# Kung mag-500 ang site pagkatapos mag-deploy, ito pa rin ang unang
# suspek — palitan lang ang pangalan nito sa server para makabalik agad.
# ============================================================

# Walang directory listing (hal. /assets/ na naglalabas ng buong listahan).
Options -Indexes

# MAHALAGA: PLAIN TEXT ang .env — kapag nabasa ito sa browser, lantad ang
# lahat ng credentials nang sabay-sabay. Ito ang tunay na mahalagang
# harang dito; ang app/ at inc/ ay pawang .php na walang inilalabas kapag
# hiniling nang diretso, kaya dagdag-lakas lang sila, hindi pangangailangan.
<FilesMatch "(?i)^(\.env.*|\.git.*|\.deployignore|.*\.(md|log|sql|bak|ini|example|yml|yaml|sh))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
