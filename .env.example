# eGradeBook — template. Kopyahin bilang .env at punan.
#   cp .env.example .env
# HUWAG maglagay ng tunay na secret dito — nasa repo ang file na ito.
#
# Kaparehong format at kaparehong reader (App\Core\Env) ng FormFlow, kaya
# kung nakagawa ka na ng .env doon, wala nang bago rito.
#
# Ang .env ay HINDI kasama sa deploy (nasa .deployignore), kaya hindi ito
# napapatungan ng push. Dalawang paraan para mailagay ito sa server:
#   · ENV_FILE secret sa GitHub — isinusulat ng deploy workflow, o
#   · isang beses mong gawin sa hPanel File Manager / SSH.
# Kapag blangko ang ENV_FILE secret, hindi ginagalaw ang nasa server.

APP_TIMEZONE=Asia/Manila

# ── eGradeBook's own database ───────────────────────────────────────
DB_HOST=localhost
DB_NAME=egradebook_db
DB_USER=root
DB_PASS=

# Gumawa ng database kung wala pa? true sa XAMPP (kaya "buksan mo lang"
# ang setup). FALSE sa shared hosting: walang CREATE DATABASE privilege
# ang MySQL user doon — ang control panel ang gumagawa nito — kaya isa
# itong query na tiyak na babagsak sa bawat request.
DB_AUTO_CREATE=true

# ── Ang dalawang bridge ─────────────────────────────────────────────
FORMFLOW_DB=formflow_db
ATTENDANCE_DB=bcc_qr_attendance_db
ATTENDANCE_TABLE=students_tbl

# HIWALAY na login para sa bawat bridge. IWANANG BLANGKO sa XAMPP: doon
# ay nababasa ng root ang tatlong database, kaya iisang koneksyon lang.
#
# KAILANGAN sa Hostinger: iisang user lang ang bawat database doon, at
# hindi ito mabibigyan ng pangalawang database. Kaya ang user ng
# eGradeBook ay tinatanggihan sa FormFlow ("SELECT command denied") —
# at babagsak pati ang LOGIN, dahil nasa FormFlow ang admin_users.
# Ilagay dito ang SARILING user at password ng database na iyon:
#   FORMFLOW_DB_*   → ang DB_USER/DB_PASS sa .env ng FormFlow
#   ATTENDANCE_DB_* → ang ginagamit ng bccsasqr (kapareho ng
#                     ROSTER_DB_USER/ROSTER_DB_PASS sa .env ng FormFlow)
# Bumabasa LANG ang eGradeBook sa dalawang iyon.
#
# *_DB_HOST: blangko = DB_HOST.
FORMFLOW_DB_USER=
FORMFLOW_DB_PASS=
FORMFLOW_DB_HOST=
ATTENDANCE_DB_USER=
ATTENDANCE_DB_PASS=
ATTENDANCE_DB_HOST=

# ── Link pabalik sa FormFlow app ────────────────────────────────────
# IWANANG BLANGKO kung ayaw mo ng link sa menu.
FORMFLOW_APP_URL=

# Saan hinahain ang FormFlow sa WEB — para sa profile photo lang.
#
# Nasa formflow_db.admin_users.avatar ang path, pero RELATIBO iyon sa
# sariling folder ng FormFlow at nasa DISK ng FormFlow ang file. SQL lang
# ang bridge natin; hindi nito naaabot ang mga file, kaya kailangan ng URL.
#
#   FORMFLOW_WEB_BASE=../FormFlow/            # magkatabi sa iisang web root
#   FORMFLOW_WEB_BASE=https://example.com/FormFlow/
#
# Ayaw ng larawan? FORMFLOW_WEB_BASE=off  (o `none`). HINDI sapat ang
# iwanang blangko: ibinabalik ng reader ang DEFAULT kapag walang laman
# ang halaga, kaya ang "FORMFLOW_WEB_BASE=" ay ../FormFlow/ pa rin.
FORMFLOW_WEB_BASE=../FormFlow/

# ────────────────────────────────────────────────────────────────────
# HALIMBAWA — Hostinger production:
#
#   APP_TIMEZONE=Asia/Manila
#   DB_HOST=localhost          # kaparehong server ang MySQL sa Hostinger
#   DB_NAME=uXXXXXXXXX_egradebook
#   DB_USER=uXXXXXXXXX_egradebook
#   DB_PASS=<mula sa hPanel>
#   DB_AUTO_CREATE=false       # hPanel ang gumagawa ng database
#   FORMFLOW_DB=uXXXXXXXXX_formflow
#   FORMFLOW_DB_USER=uXXXXXXXXX_formflow     # ang user ng FormFlow DB
#   FORMFLOW_DB_PASS=<password ng FormFlow DB, mula sa hPanel>
#   ATTENDANCE_DB=uXXXXXXXXX_sasqr
#   ATTENDANCE_DB_USER=uXXXXXXXXX_sasqr      # ang user ng attendance DB
#   ATTENDANCE_DB_PASS=<password ng attendance DB, mula sa hPanel>
#   FORMFLOW_APP_URL=https://example.com/FormFlow/
#   FORMFLOW_WEB_BASE=../FormFlow/
#
# Ang FORMFLOW_DB at ATTENDANCE_DB ay dapat EKSAKTONG tumugma sa DB_NAME
# at ROSTER_DB ng .env ng FormFlow — iisang database ang tinutukoy nila.
# Ganoon din ang mga login: FORMFLOW_DB_USER = DB_USER ng FormFlow,
# ATTENDANCE_DB_USER = ROSTER_DB_USER ng FormFlow.
